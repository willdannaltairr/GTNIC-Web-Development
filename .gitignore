# ============================================================
# GTNIC-Web-Development — Root .gitignore (Monorepo)
# Backend: backend/myapp (Node.js + Express + TypeScript)
# Frontend: frontend/my-app (Next.js + React + Tailwind)
# ============================================================

# ---------- Dependencies ----------
**/node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-store/

# ---------- Build output ----------
**/dist/
**/build/
**/out/
**/.next/
**/*.tsbuildinfo
next-env.d.ts

# ---------- Coverage / Test ----------
**/coverage/
**/.nyc_output/

# ---------- Environment ----------
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key

# ---------- Logs ----------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs/
*.log

# ---------- OS / Editor ----------
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.swp
*.swo

# ---------- Vercel / Deploy ----------
.vercel
.netlify

# ---------- Misc ----------
*.tmp
.cache/
